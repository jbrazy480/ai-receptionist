# Copy to .env and fill in real values for live phone calls.
# The offline simulator (python -m receptionist.simulate) needs none of this.

# OpenAI Realtime API key (https://platform.openai.com)
OPENAI_API_KEY=sk-placeholder

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACplaceholder
TWILIO_AUTH_TOKEN=placeholder

# Set to "false" to disable Twilio webhook signature validation for local dev
# (e.g. testing with a tool that cannot sign requests). Leave "true" in production.
VALIDATE_TWILIO_SIGNATURE=true

# Path to your business configuration file.
BUSINESS_CONFIG_PATH=business.yaml

# Port the FastAPI server listens on.
PORT=5050

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
